diff --git a/include/live_debug.hpp b/include/live_debug.hpp
index e69de29..2c60adf 100644
--- a/include/live_debug.hpp
+++ b/include/live_debug.hpp
@@ -0,0 +1,45 @@
+#pragma once
+
+// temporary file-based debug tracing for the live data pipeline.
+// writes to live_debug.log via a dedicated spdlog file sink.
+// NEVER uses std::cout / std::cerr / printf so the Notcurses TUI stays intact.
+//
+// usage:
+//   LIVE_DBG("websocket entry: price={} qty={}", p, q);
+//
+// remove this header and all LIVE_DBG calls once the pipeline is verified.
+
+#include <spdlog/spdlog.h>
+#include <spdlog/sinks/basic_file_sink.h>
+#include <memory>
+#include <mutex>
+#include <string>
+
+namespace mokuren {
+namespace debug {
+
+inline std::shared_ptr<spdlog::logger>& LiveDebugLogger() {
+  static std::shared_ptr<spdlog::logger> logger;
+  static std::once_flag init_flag;
+  std::call_once(init_flag, []() {
+    try {
+      logger = spdlog::basic_logger_mt("live_debug", "live_debug.log", /*truncate=*/false);
+      logger->set_level(spdlog::level::trace);
+      logger->set_pattern("[%Y-%m-%d %H:%M:%S.%e] [%l] %v");
+      logger->flush_on(spdlog::level::trace);
+    } catch (const spdlog::spdlog_ex&) {
+      // if the file sink cannot be created we silently disable debug logging
+      // rather than crashing the live engine.
+      logger.reset();
+    }
+  });
+  return logger;
+}
+
+} // namespace debug
+} // namespace mokuren
+
+#define LIVE_DBG(...) do { \
+  auto _dbg = ::mokuren::debug::LiveDebugLogger(); \
+  if (_dbg) _dbg->trace(__VA_ARGS__); \
+} while (0)
