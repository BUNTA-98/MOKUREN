{
  "exchange": "bybit",

  "venue": {
    "environment": "mainnet",
    "category": "linear",
    "symbol": "BTCUSDT",
    "position_mode": "one_way",
    "allow_mainnet": true
  },

  "initial_balance": 10000.0,

  "environment": {
    "filepath": "",
    "interval_ms": 60000,
    "macro_interval_ms": 900000,
    "tick_size": 0.1,
    "vwap_reset_hour": 0
  },

  "startup_probe": {
    "preset": "production",
    "min_l2_depth": 20,
    "on_failure": "abort"
  },

  "execution": {
    "taker_fee_pct": 0.0004,
    "slippage_pct": 0.0002
  },

   "prop": {
    "enabled": true,
    "max_daily_drawdown_pct": 0.04,
    "max_total_drawdown_pct": 0.06,
    "warn_fraction": 0.8,
    "daily_reset_hour_utc": 0,
    "flatten_on_breach": true
  },

  "risk": {
    "sl_pct": 0.004,
    "tp_r": 3.0,
    "risk_per_trade_pct": 0.02,
    "max_daily_loss": 400.0,
    "min_distance_dollars": 10.0,
    "modules": [
      { "active": true, "name": "SinglePositionLock" }
    ]
  },

  "trade_management": {
    "break_even": {
      "enabled": false,
      "trigger_r": 1.0,
      "target_r": 0.0
    },
    "trailing": {
      "enabled": false,
      "trigger_r": 1.0,
      "distance_r": 0.5
    },
    "scale_out": {
      "enabled": false,
      "trigger_r": 2.0,
      "fraction": 0.5
    }
  },

  "triggers": [
    {
      "name": "SpoofHunter",
      "active": true,
      "lookback_ms": 2000,
      "min_wall_qty": 0.8,
      "drop_threshold": 0.5
    }
  ],

  "filters": []
}
